# Ghostnameshop environment — copy to .env.local and fill in real values.
# NEVER commit real secrets to git.

PORT=3000

# --- PayPal (https://developer.paypal.com/dashboard) ---
PAYPAL_CLIENT_ID=your-paypal-client-id
# Same client id, exposed to the browser for the PayPal button SDK. Without it
# /checkout shows "temporarily unavailable". The client id is public; the SECRET is not.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
# Sandbox: https://api-m.sandbox.paypal.com | Live: https://api-m.paypal.com
# NOTE: a production deploy refuses to call the sandbox (guard in lib/paypal.ts, checked
# per request so `next build` still works). On a staging host that runs NODE_ENV=production,
# opt in explicitly with PAYPAL_ALLOW_SANDBOX=1.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# PAYPAL_ALLOW_SANDBOX=1
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# --- Printify (https://printify.com/app/account/api) ---
PRINTIFY_API_TOKEN=your-printify-api-token
PRINTIFY_SHOP_ID=4053686
# Set to 1 on Preview/dev so PayPal Sandbox tests never create REAL Printify orders.
PRINTIFY_DRY_RUN=1

# --- Upstash Redis (https://console.upstash.com) — order ledger + rate limits ---
UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# --- Admin dashboard ---
# Minimum 32 characters. Only the SHA-256 hash is stored in the login cookie.
ADMIN_DASHBOARD_KEY=change-me-to-a-long-random-string-at-least-32-chars

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (reserved for a future SQL store) ---
DATABASE_URL=postgresql://user:password@localhost:5432/ghostnameshop
